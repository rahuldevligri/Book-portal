    <parameter name="p_is_rtl" class="java.lang.Boolean"/>

    <queryString>
        <![CDATA[SELECT
     pd.ID AS publisher_distributor_id,
     pd.NAME AS publisher_distributor_name,
     pd.TELEPHONE AS publisher_distributor_telephone,
     pd.EMAIL AS publisher_distributor_email,
     b.ID AS book_id,
     b.TITLE AS book_title
FROM
     publisher_distributor pd
     INNER JOIN book_publisher bp ON pd.ID = bp.PUBLISHER_ID
     INNER JOIN book b ON bp.BOOK_ID = b.ID
WHERE
     pd.ID = $P{p_publisher_id} OR $P{p_publisher_id} IS NULL
ORDER BY pd.ID]]>
    </queryString>

